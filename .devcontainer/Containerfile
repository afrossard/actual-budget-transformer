# ---------------------------------------------------------------------------
# Shared base: deps common to BOTH the main devcontainer and the claude image.
# Defined once here; each service selects its stage via `target:` in compose.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/devcontainers/python:3-trixie AS base

# Security updates and default packages
RUN sudo apt-get update \
  && sudo apt-get upgrade --yes \
  && sudo apt-get install --no-install-recommends --yes vim

# Install UV - default for all python containers
COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /uvx /bin/

# ---------------------------------------------------------------------------
# Defaults for any devcontainer
# ---------------------------------------------------------------------------

# Install Homebrew
USER vscode
RUN NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Add env vars and zsh completions to ~/.zshrc
RUN cat <<EOF >> ~/.zshrc
# Homebrew env vars
eval "\$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
# Homebrew zsh completions
if type brew &>/dev/null; then
  FPATH="\$(brew --prefix)/share/zsh/site-functions:\${FPATH}"
  autoload -Uz compinit
  compinit
fi

# Starship prompt
eval "\$(starship init zsh)"
EOF

ENV PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:${PATH}"

# Default packages
RUN brew install \
  zsh-completions \
  dive \
  starship \
  gh

# Configure Starship prompt with pure preset
RUN mkdir -p ~/.config && starship preset pure-preset -o ~/.config/starship.toml

# Set zsh as default shell
RUN sudo chsh -s /bin/zsh vscode

# Install node
RUN brew install node@24

# ---------------------------------------------------------------------------
# Main devcontainer: interactive dev environment (homebrew, starship, zsh).
# ---------------------------------------------------------------------------
FROM base AS devcontainer


# ---------------------------------------------------------------------------
# Claude image: sandbox-mode tooling + claude code CLI.
# ---------------------------------------------------------------------------
FROM base AS claude

# Dependencies for claude sandbox mode
RUN sudo apt-get update \
  && sudo apt-get upgrade --yes \
  && sudo apt-get install --no-install-recommends --yes \
  bubblewrap \
  socat 

RUN npm install -g @anthropic-ai/sandbox-runtime

RUN sudo mkdir -p /home/vscode/.claude \
  && sudo chown vscode:vscode /home/vscode/.claude

USER vscode

# Install claude code
RUN curl -fsSL https://claude.ai/install.sh | bash
