{
  "name": "actual-budget-transformer",
  "version": "1.0.0",
  "private": true,
  "description": "CLI tool that transforms bank statements into Actual Budget imports",
  "type": "module",
  "scripts": {
    "import": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts' 'tests/ts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts' 'tests/ts/**/*.ts'",
    "test": "node --test --test-concurrency=1 'tests/ts/**/*.test.ts'",
    "bootstrap": "ACTUAL_DATA_DIR=/tmp/actual-data node scripts/bootstrap_test_budget.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afrossard/actual-budget-transformer.git"
  },
  "license": "ISC",
  "dependencies": {
    "@actual-app/api": "26.5.2",
    "csv-parse": "^7.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
