#!/usr/bin/env bash
# abt-import - run the import CLI's image on statement files, under msb.
#
#   abt-import [-c <config.yaml>] [--review] [--no-colour] <statement file or directory>...
#
# The config comes from -c, or else $ACTUAL_BUDGET_TRANSFORMER_CONFIG, exactly
# as for `npm run import`. The ACTUAL_BUDGET_URL and ACTUAL_BUDGET_SYNC_ID
# overrides are forwarded from this shell; ACTUAL_BUDGET_PASSWORD is not, because
# msb would show it in the process list. With no password in the config, the
# CLI asks for it on the terminal; an unattended run keeps it in the config,
# which is mounted read-only.
#
# The config and each statement file or directory are mounted read-only, and
# the CLI runs as the calling user. A statement path is mounted at its own
# absolute path under /abt/host, so the import summary names it recognisably
# and two files of the same name cannot collide. ABT_IMAGE overrides the image, e.g. for a local build.
#
# The same run under docker. `--init` is what lets Ctrl-C reach node, which is
# PID 1 there; under msb it is not:
#
#   docker run --rm -it --init \
#     --user "$(id -u):$(id -g)" \
#     -v "$PWD/config.yaml":/abt/config.yaml:ro \
#     -v "$PWD/statements":/abt/statements:ro \
#     ghcr.io/afrossard/actual-budget-transformer:<version> \
#     -c /abt/config.yaml /abt/statements
#
# CSV and CAMT.053 file output is the retired Python image's, pinned by digest
# (see README.md, "File output (retired)"):
#
#   ghcr.io/afrossard/actual-budget-transformer-main@sha256:89a73600137963c83b31a73f751b84c7cf4824150d52a3c61f9168f02a2043e8

set -euo pipefail

# The ${a[@]+"${a[@]}"} spelling below is for an empty array under `set -u`,
# which the bash 3.2 macOS ships rejects.

# The release this script belongs to; release-please bumps it.
version="0.3.0" # x-release-please-version
image=${ABT_IMAGE:-ghcr.io/afrossard/actual-budget-transformer:$version}
config=${ACTUAL_BUDGET_TRANSFORMER_CONFIG:-}
passthrough=()
statements=()

while (($# > 0)); do
  case $1 in
  -c | --config)
    if (($# < 2)); then
      echo "abt-import: $1 needs a path" >&2
      exit 2
    fi
    config=$2
    shift 2
    ;;
  --config=*)
    config=${1#--config=}
    shift
    ;;
  -c?*)
    config=${1#-c}
    shift
    ;;
  --)
    shift
    statements+=("$@")
    break
    ;;
  -*)
    passthrough+=("$1")
    shift
    ;;
  *)
    statements+=("$1")
    shift
    ;;
  esac
done

mounts=()
args=()

# A mount spec is SOURCE:DEST:OPTIONS, so a `:` in the host path would split it
# in the wrong place. Refuse it rather than guess; prints the resolved path.
mountable() {
  local path
  path=$(realpath "$1")
  if [[ $path == *:* ]]; then
    echo "abt-import: cannot mount $path: its path contains a colon" >&2
    exit 2
  fi
  printf "%s" "$path"
}

# Mounted only when given, so `abt-import --help` reaches the CLI, which owns
# the usage message.
if [[ -n $config ]]; then
  if [[ ! -f $config ]]; then
    echo "abt-import: no config file at $config" >&2
    exit 2
  fi
  host=$(mountable "$config")
  mounts+=(--mount-file "$host:/abt/config.yaml:ro")
  args+=(-c /abt/config.yaml)
fi

# Whether a statement path is already mounted there.
mounted() {
  local guest
  for guest in ${guests[@]+"${guests[@]}"}; do
    [[ $guest == "$1" ]] && return 0
  done
  return 1
}

guests=()
for statement in ${statements[@]+"${statements[@]}"}; do
  if [[ -d $statement ]]; then
    kind=--mount-dir
  elif [[ -f $statement ]]; then
    kind=--mount-file
  else
    # Passed through unmounted, so the CLI says so in its import summary and
    # the other files still import, as they do without this script.
    args+=("$statement")
    continue
  fi
  host=$(mountable "$statement")
  # The file keeps its name, and above all its extension, which the parser is
  # picked by. A path given twice is mounted once and read twice, as asked.
  guest=/abt/host$host
  if ! mounted "$guest"; then
    mounts+=("$kind" "$host:$guest:ro")
    guests+=("$guest")
  fi
  args+=("$guest")
done

# msb's -e takes KEY=value only, so a forwarded value is visible in this
# host's process list while the run lasts. That rules out the password. msb's
# --secret would hide it, but the guest then sees only a placeholder msb swaps
# in on outbound requests, which for Actual's login over HTTPS means TLS
# interception (#164).
if [[ -n ${ACTUAL_BUDGET_PASSWORD:-} ]]; then
  echo "ACTUAL_BUDGET_PASSWORD is not forwarded: it would show in the process list. The run asks for it." >&2
fi
envs=()
for var in ACTUAL_BUDGET_URL ACTUAL_BUDGET_SYNC_ID; do
  if [[ -n ${!var:-} ]]; then
    envs+=(-e "$var=${!var}")
  fi
done

# A self-hosted Actual server sits on a private address. Without these two
# flags its name did not resolve in the sandbox; with both it answered.
# `--net private` allows connecting to a private address, and
# `--no-dns-rebind-protection` lets a DNS answer pointing at one through.
exec msb run \
  --user "$(id -u):$(id -g)" \
  --net private \
  --no-dns-rebind-protection \
  ${mounts[@]+"${mounts[@]}"} \
  ${envs[@]+"${envs[@]}"} \
  "$image" \
  -- ${passthrough[@]+"${passthrough[@]}"} ${args[@]+"${args[@]}"}
